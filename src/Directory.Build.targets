<Project>
  <!-- Sign every target with the repository key unless explicitly disabled. -->
  <PropertyGroup>
    <S7CommPlusStrongName Condition="'$(S7CommPlusStrongName)' == ''">true</S7CommPlusStrongName>
    <SignAssembly>$(S7CommPlusStrongName)</SignAssembly>
    <AssemblyOriginatorKeyFile Condition="'$(SignAssembly)' == 'true'">$(MSBuildThisFileDirectory)S7CommPlusDriver.snk</AssemblyOriginatorKeyFile>
    <DefineConstants Condition="'$(SignAssembly)' == 'true'">$(DefineConstants);S7COMMPLUS_STRONG_NAME</DefineConstants>
    <WarningsAsErrors Condition="'$(SignAssembly)' == 'true' And '$(MSBuildProjectName)' == 'S7CommPlusDriver'">$(WarningsAsErrors);CS8002</WarningsAsErrors>
  </PropertyGroup>
</Project>
